<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1">
  <DUT Name="KleinEventRing" Id="{e577b11e-2da1-4542-9944-0579f144816c}">
    <Declaration><![CDATA[// Ring buffer header + 128-slot event entry array.
// Exposed as an ADS symbol (e.g. MAIN.klein_appender.ring) and read by the Go
// Klein collector's ADS receiver (github.com/siyka-au/klein,
// internal/receiver/ads/eventring.go — DrainEvents/ParseEventSlot).
//
// Binary layout — IDENTICAL in shape to Nepionic_Log_OTel.OTelLogRing (same
// 64-byte header, same 128 x 1280-byte entries array). Deliberately reusing
// the proven ring-header layout under a new type name; see KleinEventEntry's
// doc comment for why.
//
//   offset  0  UDINT  head          Monotonically increasing write counter
//   offset  4  UDINT  capacity      Number of slots = 128
//   offset  8  UDINT  overflow_cnt  Incremented when ring is full
//   offset 12  UDINT  _reserved
//   offset 16  BYTE[48] _cache_pad  Pad header to 64 bytes
//   offset 64  KleinEventEntry[128] 128 x 1280 bytes = 163840 bytes
//   Total: 163904 bytes
TYPE KleinEventRing :
STRUCT
	head : UDINT;
	capacity : UDINT := 128;
	overflow_cnt : UDINT;
	_reserved : UDINT;
	_cache_pad : ARRAY[0..47] OF BYTE;
	entries : ARRAY[0..127] OF KleinEventEntry;
END_STRUCT
END_TYPE]]></Declaration>
  </DUT>
</TcPlcObject>
