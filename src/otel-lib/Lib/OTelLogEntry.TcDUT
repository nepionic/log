<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1">
  <DUT Name="OTelLogEntry" Id="{e834f902-6e25-4540-b013-833fa7c2f8a9}">
    <Declaration><![CDATA[// One slot in the OtelLogRing.
//
// Binary layout (1280 bytes, little-endian, matches Go parser in adsbridge/ringbuf.go):
//
//   offset    0  ULINT   timestamp         Unix epoch nanoseconds
//   offset    8  UDINT   severity          0=Debug 1=Info 2=Warning 3=Error 4=Fatal
//   offset   12  UDINT   attr_count        Number of populated entries in attrs (0..10)
//   offset   16  BYTE[192] message         STRING(191) null-terminated
//   offset  208  BYTE[64]  source          STRING(63)  null-terminated (instance path)
//   offset  272  BYTE[960] attrs           ARRAY[0..9] OF OtelLogAttribute
//                                            each attr: key STRING(31)=32 bytes
//                                                       value STRING(63)=64 bytes = 96 bytes
//   offset 1232  BYTE[44]  _pad
//   offset 1276  UDINT   sequence          ODD=being written, EVEN=committed (LAST field)
//   Total: 1280 bytes
TYPE INTERNAL OTelLogEntry :
STRUCT
	timestamp : ULINT;
	severity : UDINT;
	attr_count : UDINT;
	message : STRING(191);
	source : STRING(63);
	attrs : ARRAY[0..9] OF Nepionic_Log.OtelLogAttribute;
	_pad : ARRAY[0..43] OF BYTE;
	sequence : UDINT;
END_STRUCT
END_TYPE]]></Declaration>
  </DUT>
</TcPlcObject>