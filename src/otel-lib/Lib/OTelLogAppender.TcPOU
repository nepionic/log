<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1">
  <POU Name="OTelLogAppender" Id="{ab1cd2e3-f4a5-6789-ab1c-d2e3f4a56789}" SpecialFunc="None">
    <Declaration><![CDATA[{attribute 'linkalways'}
{attribute 'no_explicit_call' := 'This FB is a CLASS and must be accessed using methods or properties'}
{attribute 'enable_dynamic_creation'}
/// OTel log appender for Nepionic_Log.
/// Implements `LogAppender` by writing structured log entries directly into its
/// own `OTelLogRing` field (`Ring`), which is exposed as an ADS symbol and
/// consumed by the Go `otelcol-ads` collector.
///
/// The ring is owned by the appender — no external ring declaration is needed.
/// Just declare the appender in a PROGRAM or GVL so TwinCAT generates an ADS
/// symbol for it, then point the collector at `<PROGRAM>.<var_name>.Ring`.
///
/// Usage:
/// ```st
/// // startup (e.g. MAIN FB_Init)
/// GetLogManager().Register(otel_appender);
///
/// // otelcol-ads config:
/// //   symbol: MAIN.otel_appender.Ring
/// ```
FUNCTION_BLOCK PUBLIC OTelLogAppender IMPLEMENTS Nepionic_Log.LogAppender
VAR
	ring : OTelLogRing;
	_level : Nepionic_Log.LogLevel := Nepionic_Log.LogLevel.Debug;
END_VAR]]></Declaration>
    <Implementation>
      <ST><![CDATA[]]></ST>
    </Implementation>
    <Method Name="Append" Id="{bc2de3f4-a5b6-7890-bc2d-e3f4a5b67890}">
      <Declaration><![CDATA[METHOD PUBLIC Append : BOOL
VAR_INPUT
	level : Nepionic_Log.LogLevel;
	message : Tc2_System.T_MaxString;
	source : Tc2_System.T_MaxString;
	attributes : ARRAY[0..9] OF Nepionic_Log.LogAttribute;
	attribute_count : USINT;
END_VAR
VAR
	slot_idx : UDINT;
	expected_gen : UDINT;
	file_time : ULINT;
	i : USINT;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[slot_idx := ring.head MOD 128;
expected_gen := (ring.head / 128 + 1) * 2;

// Mark slot as being written (ODD sequence = write in progress)
ring.entries[slot_idx].sequence := expected_gen - 1;

// Timestamp — Windows FILETIME → Unix nanoseconds
file_time := Tc2_Utilities.F_GetSystemTime();
ring.entries[slot_idx].timestamp := (file_time - 116444736000000000) * 100;

// Severity mapping
CASE level OF
	Nepionic_Log.LogLevel.Debug:
		ring.entries[slot_idx].severity := 0;
	Nepionic_Log.LogLevel.Information:
		ring.entries[slot_idx].severity := 1;
	Nepionic_Log.LogLevel.Warning:
		ring.entries[slot_idx].severity := 2;
	Nepionic_Log.LogLevel.Error:
		ring.entries[slot_idx].severity := 3;
	Nepionic_Log.LogLevel.Fatal:
		ring.entries[slot_idx].severity := 4;
ELSE
	ring.entries[slot_idx].severity := 1;
END_CASE

// Payload
ring.entries[slot_idx].message := message;
ring.entries[slot_idx].source := source;
ring.entries[slot_idx].attribute_count := USINT_TO_UDINT(attribute_count);
FOR i := 0 TO 9 DO
	ring.entries[slot_idx].attributes[i] := attributes[i];
END_FOR

// Commit slot (EVEN sequence = ready for reader)
ring.entries[slot_idx].sequence := expected_gen;

// Advance write cursor
ring.head := ring.head + 1;

Append := TRUE;]]></ST>
      </Implementation>
    </Method>
    <Property Name="Level" Id="{cd3ef4a5-b6c7-8901-cd3e-f4a5b6c78901}">
      <Declaration><![CDATA[{attribute 'monitoring' := 'call'}
PROPERTY PUBLIC Level : Nepionic_Log.LogLevel]]></Declaration>
      <Get Name="Get" Id="{de4fa5b6-c7d8-9012-de4f-a5b6c7d89012}">
        <Declaration><![CDATA[PUBLIC]]></Declaration>
        <Implementation>
          <ST><![CDATA[Level := _level;]]></ST>
        </Implementation>
      </Get>
      <Set Name="Set" Id="{ef5ab6c7-d8e9-0123-ef5a-b6c7d8e90123}">
        <Declaration><![CDATA[PUBLIC]]></Declaration>
        <Implementation>
          <ST><![CDATA[_level := Level;]]></ST>
        </Implementation>
      </Set>
    </Property>
  </POU>
</TcPlcObject>