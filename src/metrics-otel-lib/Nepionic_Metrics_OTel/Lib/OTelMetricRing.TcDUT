<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1" ProductVersion="3.1.4026.20">
	<DUT Name="OTelMetricRing" Id="{C1FFCAC2-BC23-4C9E-AA4D-E1C397D51BA5}">
		<Declaration><![CDATA[// Ring buffer header + 256-slot metric entry array.
// Exposed as an ADS symbol (e.g. OtelBridge.MetricRing) and read by the Go collector.
//
// Binary layout:
//   offset      0  UDINT  head          Monotonically increasing write counter
//   offset      4  UDINT  capacity      Number of slots = 256
//   offset      8  UDINT  overflow_cnt  Incremented when ring is full
//   offset     12  UDINT  _reserved
//   offset     16  BYTE[48] _cache_pad  Pad header to 64 bytes
//   offset     64  OtelMetricEntry[256] 256 x 672 bytes = 172032 bytes
//   Total: 172096 bytes
TYPE OTelMetricRing :
STRUCT
	head         : UDINT;
	capacity     : UDINT := 256;
	overflow_cnt : UDINT;
	_reserved    : UDINT;
	_cache_pad   : ARRAY[0..47] OF BYTE;
	entries      : ARRAY[0..255] OF OTelMetricEntry;
END_STRUCT
END_TYPE]]></Declaration>
	</DUT>
</TcPlcObject>