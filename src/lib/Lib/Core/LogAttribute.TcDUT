<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1">
  <DUT Name="LogAttribute" Id="{ef47fdc6-9af5-420d-bae5-f564b9eecd3b}">
    <Declaration><![CDATA[// A single structured log attribute — a key/value pair attached to a log entry.
// Used by LogCore.LogWithAttributes and consumed by OtelLogCore.
TYPE LogAttribute :
STRUCT
	// Attribute name  e.g. 'event.name', 'previous_state'
	key : STRING(31);
	// Attribute value e.g. 'axis.state_changed', 'Idle'
	value : STRING(63);
END_STRUCT
END_TYPE]]></Declaration>
  </DUT>
</TcPlcObject>